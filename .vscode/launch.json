{
  // F5 no VS Code (painel "Executar e Depurar", Ctrl+Shift+D). Baseado no guia oficial do Next 16
  // (node_modules/next/dist/docs/01-app/02-guides/debugging.md), com pnpm e o servidor escutando
  // só em 127.0.0.1, como o `pnpm dev` (ADR-0025). Antes de subir o servidor, o F5 roda o
  // `pnpm install` (.vscode/tasks.json). Pare o `pnpm dev` do terminal antes de apertar F5, para os
  // dois não disputarem a porta 3000.
  "version": "0.2.0",
  "configurations": [
    {
      // Padrão do F5, para USAR o app: compila tudo uma vez (cerca de 1 minuto; depois o cache
      // ajuda) e abre no seu navegador. As páginas não compilam mais ao abrir e o React roda na
      // versão otimizada: é o modo mais rápido. Mudanças no código só valem no próximo F5.
      "name": "Usar o app (versão rápida)",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "Preparar a versão rápida (pnpm build)",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "args": ["start", "-H", "127.0.0.1"],
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s"
      }
    },
    {
      // Para MEXER no código: recompila a cada arquivo salvo e abre o Edge já depurando (pontos
      // de parada no servidor e no navegador). Cada página compila na primeira visita e o React
      // roda na versão de desenvolvimento: é mais lento. Shift+F5 desliga o servidor.
      "name": "Desenvolver (recompila ao salvar, com depurador)",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "Instalar dependências (pnpm install)",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "args": ["dev", "-H", "127.0.0.1"],
      "runtimeArgs": ["--inspect"],
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "debugWithEdge",
        "killOnServerStop": true,
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "webRoot": "${workspaceFolder}"
      }
    },
    {
      // Só o servidor de desenvolvimento, num terminal do VS Code. Abra http://localhost:3000 no
      // navegador que preferir; os pontos de parada valem para o código do servidor.
      "name": "Só o servidor (abra o navegador você mesmo)",
      "type": "node-terminal",
      "request": "launch",
      "preLaunchTask": "Instalar dependências (pnpm install)",
      "command": "pnpm dev --inspect"
    },
    {
      // Só o navegador (Edge), com o servidor já rodando (`pnpm dev` ou a opção acima).
      "name": "Só o navegador (servidor já rodando)",
      "type": "msedge",
      "request": "launch",
      "url": "http://127.0.0.1:3000",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
