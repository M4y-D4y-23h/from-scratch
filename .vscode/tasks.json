{
  // Tarefas do VS Code usadas pelo F5 (.vscode/launch.json).
  "version": "2.0.0",
  "tasks": [
    {
      // Antes de subir o app, instala o que faltar: na primeira vez, ou depois de um `git pull` que
      // trouxe dependência nova. Quando já está tudo instalado, leva só alguns segundos.
      "label": "Instalar dependências (pnpm install)",
      "type": "shell",
      "command": "pnpm install",
      "problemMatcher": []
    },
    {
      // Versão rápida: compila o app inteiro de uma vez (cerca de 1 minuto; as próximas vezes
      // reaproveitam o cache). Depois disso nenhuma página precisa compilar ao ser aberta.
      "label": "Preparar a versão rápida (pnpm build)",
      "type": "shell",
      "command": "pnpm build",
      "dependsOn": "Instalar dependências (pnpm install)",
      "problemMatcher": []
    }
  ]
}
