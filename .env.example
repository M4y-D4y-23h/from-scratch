# Copie este arquivo para .env.local e preencha. O .env.local NUNCA vai para o git.
# No PowerShell:  Copy-Item .env.example .env.local

# Chave da API da Anthropic (Claude). Usada só no servidor. Opcional: sem ela, o app lê os
# pedidos no "modo simples" (palavras-chave). Com ela, cada pedido novo é uma chamada paga.
# Crie a chave no console da Anthropic (seção "API Keys") e cole depois do "=".
ANTHROPIC_API_KEY=

# Opcional: "simples" desliga a IA mesmo com a chave preenchida (sem custo).
# FROM_SCRATCH_LLM=simples

# Opcional: onde fica o banco SQLite local. Padrão: data/local/from-scratch.db
# FROM_SCRATCH_DB=data/local/from-scratch.db
